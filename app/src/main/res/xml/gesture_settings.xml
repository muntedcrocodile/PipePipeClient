<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:app="http://schemas.android.com/apk/res-auto"
                  android:key="general_preferences"
                  android:title="@string/settings_category_gestures_summary">
    <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/volume_gesture_control_key"
            android:summary="@string/volume_gesture_control_summary"
            android:title="@string/volume_gesture_control_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/brightness_gesture_control_key"
            android:summary="@string/brightness_gesture_control_summary"
            android:title="@string/brightness_gesture_control_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/fullscreen_gesture_control_key"
            android:summary="@string/fullscreen_gesture_control_summary"
            android:title="@string/fullscreen_gesture_control_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <ListPreference
            android:defaultValue="@string/minimize_gesture_control_value"
            android:entries="@array/minimize_gesture_action_description"
            android:entryValues="@array/minimize_gesture_action_key"
            android:key="@string/minimize_gesture_control_key"
            android:summary="@string/minimize_gesture_control_summary"
            android:title="@string/minimize_gesture_control_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/playback_speed_gesture_control_key"
            android:summary="@string/playback_speed_gesture_control_summary"
            android:title="@string/playback_speed_gesture_control_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/swipe_seek_gesture_control_key"
            android:summary="@string/swipe_seek_gesture_control_summary"
            android:title="@string/swipe_seek_gesture_control_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/pinch_to_zoom_gesture_control_key"
            android:summary="@string/pinch_to_zoom_gesture_control_summary"
            android:title="@string/pinch_to_zoom_gesture_control_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:defaultValue="true"
            android:key="@string/lock_screen_button_key"
            android:summary="@string/lock_screen_button_summary"
            android:title="@string/lock_screen_button_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <ListPreference
            android:defaultValue="@string/seek_duration_default_value"
            android:entries="@array/seek_duration_description"
            android:entryValues="@array/seek_duration_value"
            android:key="@string/seek_duration_key"
            android:summary="%s"
            android:title="@string/seek_duration_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <ListPreference
            android:defaultValue="@string/speeding_playback_default_value"
            android:entries="@array/speeding_playback_description"
            android:entryValues="@array/speeding_playback_value"
            android:key="@string/speeding_playback_key"
            android:summary="%s"
            android:title="@string/speeding_playback_title"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
            android:key="@string/pull_to_refresh_key"
            android:title="@string/pull_to_refresh_title"
            android:summary="@string/pull_to_refresh_summary"
            android:defaultValue="true"
            app:singleLineTitle="false"
            app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:key="@string/video_swipe_enabled_key"
        android:title="@string/video_swipe_title"
        android:summary="@string/video_swipe_summary"
        android:defaultValue="false"
        app:iconSpaceReserved="false" />
    <ListPreference
        android:key="@string/video_swipe_left_action_key"
        android:title="@string/video_swipe_left_title"
        android:dependency="@string/video_swipe_enabled_key"
        android:defaultValue="enqueue_next"
        android:entries="@array/video_swipe_action_entries"
        android:entryValues="@array/video_swipe_action_values"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />
    <ListPreference
        android:key="@string/video_swipe_right_action_key"
        android:title="@string/video_swipe_right_title"
        android:dependency="@string/video_swipe_enabled_key"
        android:defaultValue="enqueue"
        android:entries="@array/video_swipe_action_entries"
        android:entryValues="@array/video_swipe_action_values"
        app:useSimpleSummaryProvider="true"
        app:iconSpaceReserved="false" />
</PreferenceScreen>
